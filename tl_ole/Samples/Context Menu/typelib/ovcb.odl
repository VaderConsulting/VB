[
    uuid(13005660-e0a2-11d4-b99a-8c443e1d8f61),
    helpstring("Edanmo's IOleVerbCallback interface v1.0"),
    version(1.0)
]
library ovcb {

    importlib("stdole2.tlb");
    importlib("olelib.tlb");

    typedef enum MenuFlags {
        MF_SEPARATOR        = 0x00000800,
        MF_ENABLED          = 0x00000000,
        MF_GRAYED           = 0x00000001,
        MF_DISABLED         = 0x00000002,
        MF_UNCHECKED        = 0x00000000,
        MF_CHECKED          = 0x00000008,
        MF_USECHECKBITMAPS  = 0x00000200,
        MF_MENUBARBREAK     = 0x00000020,
        MF_MENUBREAK        = 0x00000040,
        MF_UNHILITE         = 0x00000000,
        MF_HILITE           = 0x00000080,
        MF_DEFAULT          = 0x00001000,
        MF_RIGHTJUSTIFY     = 0x00004000,
        MFT_RADIOCHECK      = 0x00000200,
    } MenuFlags;

    [
        odl,
        uuid(13005661-e0a2-11d4-b99a-8c443e1d8f61)
    ]
    interface IOleVerbCallback : IUnknown {

        HRESULT DoVerb(
            [in] LONG iVerb,
            [in, out] MSG *lpmsg,
            [in] IOleClientSite *pActiveSite,
            [in] LONG lindex,
            [in] LONG hwndParent,
            [in, out] RECT *lprcPosRect,
            [out, retval] LONG *ret);

        HRESULT AddMenuItem(
            [in] BSTR Name,
            [in] LONG iVerb,
            [in, defaultvalue(0)] MenuFlags Flags,
            [out, retval] LONG *Idx);

    }

}
