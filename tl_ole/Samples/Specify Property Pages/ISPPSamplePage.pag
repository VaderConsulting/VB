VERSION 5.00
Begin VB.PropertyPage ISPPSamplePage 
   Caption         =   "ISPP Sample Page"
   ClientHeight    =   1230
   ClientLeft      =   0
   ClientTop       =   0
   ClientWidth     =   2940
   PaletteMode     =   0  'Halftone
   ScaleHeight     =   1230
   ScaleWidth      =   2940
   Begin VB.TextBox txtText 
      Height          =   330
      Left            =   90
      TabIndex        =   2
      Top             =   735
      Width           =   2700
   End
   Begin VB.CheckBox chkEnabled 
      Caption         =   "Enabled"
      Height          =   285
      Left            =   90
      TabIndex        =   0
      Top             =   120
      Width           =   2700
   End
   Begin VB.Label lblText 
      Caption         =   "Text:"
      Height          =   240
      Left            =   75
      TabIndex        =   1
      Top             =   480
      Width           =   2700
   End
End
Attribute VB_Name = "ISPPSamplePage"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Option Explicit




Private Sub txtText_Change()
    Changed = True
End Sub


Private Sub chkEnabled_Click()
    Changed = True
End Sub


Private Sub PropertyPage_ApplyChanges()
    SelectedControls(0).Text.Text = txtText.Text
    SelectedControls(0).Enabled = (chkEnabled.Value = vbChecked)
End Sub



Private Sub PropertyPage_SelectionChanged()
    txtText.Text = SelectedControls(0).Text.Text
    chkEnabled.Value = (SelectedControls(0).Enabled And vbChecked)
End Sub


