Private Sub PropertyPage_ApplyChanges()
    SelectedControls(0).CommPort = txtCommPort.Text
    SelectedControls(0).Settings = txtSettings.Text
    SelectedControls(0).Delay = txtDelay.Text
    SelectedControls(0).Enabled = (chkEnabled.Value = vbChecked)
End Sub

Private Sub PropertyPage_SelectionChanged()
    'Dim varSettings As String
    'Dim varSpeed As Long
    'Dim place As Integer
    'Dim a As Integer
    txtCommPort.Text = SelectedControls(0).CommPort
    txtSettings.Text = SelectedControls(0).Settings
    txtDelay.Text = SelectedControls(0).Delay
    chkEnabled.Value = (SelectedControls(0).Enabled And vbChecked)
