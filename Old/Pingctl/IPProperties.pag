Attribute VB_Name = "IPProperties"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Private Sub lblIPAddress_Click()

End Sub

Private Sub txtOctet1_Click()
    txtOctet1.SelLength = 5
End Sub

Private Sub txtPING_TIMEOUT_Change()
    Changed = True
End Sub


Private Sub txtOctet4_Change()
    Changed = True
End Sub


Private Sub txtOctet3_Change()
    Changed = True
End Sub


Private Sub txtOctet2_Change()
    Changed = True
End Sub


Private Sub txtOctet1_Change()
    Changed = True
End Sub


Private Sub txtIPAddress_Change()
    Changed = True
End Sub


Private Sub chkEnabled_Click()
    Changed = True
End Sub


Private Sub PropertyPage_ApplyChanges()
    SelectedControls(0).PING_TIMEOUT = txtPING_TIMEOUT.Text
    SelectedControls(0).Octet4 = txtOctet4.Text
    SelectedControls(0).Octet3 = txtOctet3.Text
    SelectedControls(0).Octet2 = txtOctet2.Text
    SelectedControls(0).Octet1 = txtOctet1.Text
    SelectedControls(0).Enabled = (chkEnabled.Value = vbChecked)
End Sub


Private Sub PropertyPage_SelectionChanged()
    txtPING_TIMEOUT.Text = SelectedControls(0).PING_TIMEOUT
    txtOctet4.Text = SelectedControls(0).Octet4
    txtOctet3.Text = SelectedControls(0).Octet3
    txtOctet2.Text = SelectedControls(0).Octet2
    txtOctet1.Text = SelectedControls(0).Octet1
    chkEnabled.Value = (SelectedControls(0).Enabled And vbChecked)
End Sub


