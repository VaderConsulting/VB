Option Explicit

Private Sub Form_Click()
    Rem close the splash screen with a mouse click
    Unload Me
End Sub

Private Sub Form_KeyPress(KeyAscii As Integer)
    Rem close the splash screen with any key press
    Unload Me
End Sub

Private Sub Form_Load()
    Rem set up the splash screen
    lblVersion.Caption = "Version " & App.Major & "." & App.Revision
    lblProductName.Caption = App.Title
End Sub

