 // lparam = LPLONG for TCP/IP address
        IPM_SETRANGE = (0x400+103), // wparam = field, lparam = range
        IPM_SETFOCUS = (0x400+104), // wparam = field
        IPM_ISBLANK = (0x400+105), // no parameters
    } IPAddressMessages;

